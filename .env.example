# Set to true only for local demo builds without a backend.
VITE_DEMO_MODE=false

# InsForge BaaS
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=

# Optional internal SIPANDU integration proxy. Provider keys stay server-side.
VITE_SIPANDU_API_URL=/api

# ---- Server-side only (JANGAN pakai prefix VITE_) ----
# api/ecosystem/citizen-summary.ts (Citizen 360 ke SINDUKSADATI)
ECOSYSTEM_SERVICE_KEY=
INSFORGE_API_KEY=

# functions/sinduksadati-proxy.ts (Deno edge function secrets)
SINDUKSADATI_API_URL=
SINDUKSADATI_SERVICE_KEY=

# functions/webhook-sinduksadati.ts (HMAC verification; wajib — fail-closed)
SINDUKSADATI_WEBHOOK_SECRET=
